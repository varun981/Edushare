# Copy this file to .env and fill in values for your environment.
# Never commit .env or real credentials.

FLASK_CONFIG=development
# Generate a strong value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-key

# MySQL is used when DATABASE_URL is set. Leave it blank for local SQLite.
# Replace every placeholder below with values supplied by your MySQL host.
# DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME?charset=utf8mb4
DATABASE_URL=

SESSION_COOKIE_SECURE=0
RATELIMIT_ENABLED=1
# Use a shared store (e.g. Redis) when running more than one web process.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
AUTO_CREATE_TABLES=1
# Set to 1 only behind a trusted reverse proxy (e.g. Render).
TRUST_PROXY=0

# Optional password-reset e-mail. Without these, production shows a generic
# confirmation only; development/testing may show the link on screen.
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=your-smtp-user
# MAIL_PASSWORD=your-smtp-password
# MAIL_DEFAULT_SENDER=no-reply@example.com
